@model _25dh110017_Mystore.Models.Product

<head>
    <style>
        img {
            height: 200px;
            max-width: 200px;
            object-fit: cover;
        }
    </style>
</head>

<div class="container-fluid">
    <div class="row bg-info" style="padding: 15px;">
        <div class="col-md-3">
            <img src="@Url.Content(Model.ProductImage ?? "~/Content/images/default_img.png")" />
        </div>
        <div class="col-md-9">
            <dl class="dl-horizontal">
                <dt>Tên sản phẩm</dt>
                <dd>@Html.DisplayFor(model => model.ProductName)</dd>

                <dt>Mô tả</dt>
                <dd>@Html.DisplayFor(model => model.ProductDescription)</dd>

                <dt>Đơn giá</dt>
                <dd>@Html.DisplayFor(model => model.ProductPrice)</dd>

                <dt>Danh mục</dt>
                <dd>@Html.DisplayFor(model => model.Category.CategoryName)</dd>
            </dl>
        </div>
    </div>
</div>