@model _25dh110017_Mystore.Models.Cart.Cart

@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top:30px;">
    <h2><i class="glyphicon glyphicon-shopping-cart"></i> Giỏ hàng của bạn</h2>
    <hr />

    @if (Model != null && Model.Items.Any())
    {
        <table class="table table-bordered table-striped align-middle">
            <thead>
                <tr class="active">
                    <th class="text-center">Hình ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th class="text-right">Đơn giá</th>
                    <th class="text-center" style="width:150px;">Số lượng</th>
                    <th class="text-right">Thành tiền</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-center">
                            <img src="@Url.Content(item.product.ProductImage)" alt="@item.product.ProductName" style="width:60px; height:60px; object-fit:cover;" />
                        </td>
                        <td>
                            <strong>@item.product.ProductName</strong>
                        </td>
                        <td class="text-right">@item.product.ProductPrice.ToString("N0") VNĐ</td>
                        <td>
                            @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { @class = "form-inline text-center" }))
                            {
                                @Html.Hidden("productID", item.product.ProductID)
                                <input type="number" name="quantity" value="@item.quantity" min="1" max="100" class="form-control input-sm" style="width:65px; display:inline-block;" />
                                <button type="submit" class="btn btn-primary btn-sm" title="Cập nhật"><i class="glyphicon glyphicon-refresh"></i></button>
                            }
                        </td>
                        <td class="text-right"><strong>@item.TotalPrice.ToString("N0") VNĐ</strong></td>
                        <td class="text-center">
                            <a href="@Url.Action("RemoveFromCart", "Cart", new { productID = item.product.ProductID })" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                <i class="glyphicon glyphicon-trash"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-right"><h4><strong>Tổng tiền thanh toán:</strong></h4></td>
                    <td class="text-right"><h4 class="text-danger"><strong>@Model.TotalValue().ToString("N0") VNĐ</strong></h4></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>

        <div class="row" style="margin-top:20px; margin-bottom:40px;">
            <div class="col-md-6">
                <a href="@Url.Action("Index", "Home")" class="btn btn-default btn-lg">
                    <i class="glyphicon glyphicon-arrow-left"></i> Tiếp tục mua hàng
                </a>
            </div>
            <div class="col-md-6 text-right">
                <a href="@Url.Action("Checkout", "Order")" class="btn btn-success btn-lg">
                    Tiến hành thanh toán <i class="glyphicon glyphicon-arrow-right"></i>
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center" style="padding:40px 0;">
            <h3>Giỏ hàng của bạn đang trống!</h3>
            <p>Hãy chọn thêm sản phẩm vào giỏ hàng để tiến hành mua sắm nhé.</p>
            <br />
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg">
                <i class="glyphicon glyphicon-shopping-cart"></i> Khám phá sản phẩm ngay
            </a>
        </div>
    }
</div>