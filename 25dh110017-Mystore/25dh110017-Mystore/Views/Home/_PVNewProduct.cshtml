@model _25dh110017_Mystore.Models.ViewModel.HomeProductVM
@using PagedList.Mvc;
@using PagedList;
@using System.Linq;
@using _25dh110017_Mystore.Models;

<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css" />

<!-- Hiển thị danh sách sản phẩm mới -->
@if (Model != null && Model.NewProducts != null && Model.NewProducts.Any())
{
    <section class="container-fluid listProduct">
        <h2>Sản phẩm mới</h2>
        <ul class="list-container">
            @foreach (var product in Model.NewProducts)
            {
                <li class="lproduct-item">
                    <div>
                        <a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID })">
                            <img src="@product.ProductImage" alt="@product.ProductName" />
                        </a>
                    </div>
                    <div>
                        <p class="prodPrice">@product.ProductPrice.ToString("N0") VNĐ</p>
                        <p class="prodName">@product.ProductName</p>
                        <p class="prodSale">
                            Đã bán:&nbsp;@(product.OrderDetails != null ? product.OrderDetails.Count : 0)
                        </p>
                    </div>
                </li>
            }
        </ul>
    </section>

    <!-- Hiển thị phân trang -->
    <div class="pagination-container">
        @Html.PagedListPager(Model.NewProducts, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm }))
    </div>
}
else
{
    <p>Không tìm thấy sản phẩm nào phù hợp.</p>
}